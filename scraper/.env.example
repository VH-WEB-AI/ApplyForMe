# ============================================================
# smart_scraper_jobs — environment template
# Copy to .env and fill in. NEVER commit the real .env file.
# ============================================================

# --- Backend API (fill in once you have it) ---
# Every scrape run POSTs batches of scraped jobs here as JSON:
#   { "source": "smart_scraper_jobs", "jobs": [ {Portal, Job Title, Company, ...}, ... ] }
# Leave blank to skip posting — the scraper still writes a local CSV either way.
BACKEND_API_URL=
BACKEND_API_KEY=
BACKEND_API_BATCH_SIZE=100
BACKEND_API_TIMEOUT=30

# --- Admin job-creation API (e.g. https://admin.applyforme.us/api/jobs/intake) ---
# Different shape than BACKEND_API_URL above: one job object POSTed per request,
# authenticated via the x-jobs-key header (not Bearer), fields are company/role/
# platform/location/remote/salaryMin/salaryMax/seniority/visaSponsorship/
# employmentType/description/requiredSkills/sourceLink/active. Leave blank to skip.
ADMIN_API_URL=
ADMIN_API_TOKEN=
ADMIN_API_TIMEOUT=30
# Local file tracking jobs already sent (dedup key: scraped URL, or company+role
# if no URL) so re-running the scraper doesn't resend the same postings.
ADMIN_API_STATE_PATH=

# --- Scheduling (docker-compose / run_loop.sh only) ---
SCRAPE_INTERVAL_SECONDS=86400
LIMIT_PER_PORTAL=25

# --- Optional: portals that require a free API key (skipped if unset) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# --- Optional: LLM refinement (non-English translation + real-job validation) ---
# Requires `pip install -r requirements-llm.txt` (pulls in torch, ~2GB) —
# not installed by default in the Docker image.
ENABLE_LLM_REFINEMENT=0
LLM_MODEL=google/gemma-3-270m
HUGGINGFACE_TOKEN=
STRICT_VALIDATION=1
