# --- App ---
APP_NAME=ApplyForMe
ENV=development
DEBUG=true
AI_ENABLED=true
API_V1_PREFIX=/api/v1

# --- Security ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (Postgres + pgvector) ---
DATABASE_URL=postgresql+asyncpg://applyforme:applyforme@postgres:5432/applyforme
SYNC_DATABASE_URL=postgresql+psycopg2://applyforme:applyforme@postgres:5432/applyforme

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- AI provider ---
# Choose one: "openai" or "gemini". Only the selected provider needs a key.
AI_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-replace-me
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# --- Google Gemini ---
# Get a Gemini Developer API key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=3072

# --- Cache TTLs (seconds) ---
CACHE_TTL_DEFAULT=3600
CACHE_TTL_EMBEDDINGS=86400

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LOG_LEVEL=INFO

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]
