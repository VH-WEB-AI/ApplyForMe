# Copy this file to .env and fill in real values. Never commit .env.

# OpenAI (or any OpenAI-compatible provider - swap OPENAI_BASE_URL to point elsewhere)
OPENAI_API_KEY=sk-replace-me
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REASONING_EFFORT=low
OPENAI_BASE_URL=

# Database (overridden by docker-compose for the backend container).
# Host-side default below uses 5433/6380 to avoid clashing with other local services;
# adjust if your machine's ports differ.
DATABASE_URL=postgresql+psycopg://applyforme:applyforme@localhost:5440/applyforme

# Cache / Queue
REDIS_URL=redis://localhost:6390/0

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
